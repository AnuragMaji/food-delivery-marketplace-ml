# Postgres (local docker-compose default shown; replace with Neon URL when deployed)
# Uses host port 5433 (not 5432) to avoid clashing with a native Postgres install, if present
POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/food_delivery

# Redis (local docker-compose default shown; replace with Upstash URL when deployed)
REDIS_URL=redis://localhost:6379/0

# Redpanda / Kafka-compatible broker
REDPANDA_BROKERS=localhost:19092
DELIVERIES_TOPIC=deliveries.raw

# Model API
MODEL_API_URL=http://localhost:8000
